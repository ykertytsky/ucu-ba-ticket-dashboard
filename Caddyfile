# Optional second layer for the public internet: bcrypt basicauth (see `caddy hash-password`),
# in addition to the app login when DASHBOARD_GATE_SECRET is set.
#
# Inside the site block, before reverse_proxy:
#   basicauth /* {
#     {$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
#   }

{$CADDY_DOMAIN:localhost} {
  reverse_proxy app:3000
}
